# Public (frontend) – safe to ship in the static bundle.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Local-only (DB test runner and migrations). NEVER prefix with NEXT_PUBLIC_, never commit.
# Postgres connection string of the DEV project (Supabase → Project Settings → Database).
SUPABASE_DB_URL=

# service_role key is NOT used by the frontend. It lives only in `supabase secrets` (Edge Functions).
# Do not put it here unless a local script strictly needs it.
