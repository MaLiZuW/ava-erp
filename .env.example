# Public (frontend) – safe to ship in the static bundle.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Local-only (DB test runner and migrations). NEVER prefix with NEXT_PUBLIC_, never commit.
# Postgres connection string of the DEV project (Supabase → Project Settings → Database).
SUPABASE_DB_URL=

# Secret key (Supabase → Project Settings → API Keys → "Secret keys", sb_secret_…) – LOCAL SCRIPTS ONLY:
# creates and deletes disposable test users (*@test.invalid) on the DEV project for db:test:api and e2e.
# NEVER prefix with NEXT_PUBLIC_, never commit, never use it on the production project.
SUPABASE_SECRET_KEY=
