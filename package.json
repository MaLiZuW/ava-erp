    "db:test:local": "tsx scripts/db-test-local.ts",
    "db:seed": "tsx scripts/db-seed.ts",
    "db:test:api": "tsx scripts/api-test.ts",
    "db:reset:dev": "tsx scripts/db-reset-dev.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@hookform/resolvers": "^7.0.9",
    "@supabase/supabase-js": "^2.119.2",
    "@tanstack/react-query": "^5.108.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.81.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.92.0",
    "tailwind-merge": "^3.7.1",
    "zod": "^4.6.7"
  },
